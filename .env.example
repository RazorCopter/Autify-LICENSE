# Generare due valori distinti con: openssl rand -hex 32
LICENSE_SHARED_SECRET=CAMBIA_CON_UNA_STRINGA_RANDOM_DI_ALMENO_32_CARATTERI
LICENSE_ADMIN_KEY=CAMBIA_CON_UN_ALTRA_STRINGA_RANDOM_DI_ALMENO_32_CARATTERI
LICENSE_ADMIN_SESSION_HOURS=8
# Lasciare true in produzione HTTPS. Usare false solo per test HTTP locali.
LICENSE_ADMIN_COOKIE_SECURE=true

# Il bind locale e' raccomandato quando nginx/Traefik pubblica il servizio HTTPS.
LICENSE_BIND_ADDRESS=127.0.0.1
LICENSE_PORT=8001
LICENSE_REQUEST_FRESHNESS_SECONDS=120
LICENSE_ACTIVATE_RATE_LIMIT=10/minute
LICENSE_VALIDATE_RATE_LIMIT=60/minute